; Engine configuration file.
config_version=5

[application]

config/name="Jade Valley Chronicles"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

Loc="*res://scripts/services/localization_service.gd"
Layout="*res://scripts/services/layout_service.gd"
Router="*res://scripts/services/scene_router.gd"
Saves="*res://scripts/services/save_service.gd"
Audio="*res://scripts/services/audio_service.gd"
DragScroll="*res://scripts/services/drag_scroll.gd"
Content="*res://scripts/services/content_service.gd"
Game="*res://scripts/services/game_session.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[gui]

theme/custom_font="res://fonts/NotoSansSC-subset.otf"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
