; Engine configuration file.
config_version=5

[application]

config/name="Jade Valley Chronicles"
run/main_scene="res://scenes/spike/spike.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

Loc="*res://scripts/services/localization_service.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[gui]

theme/custom_font="res://fonts/NotoSansSC-subset.otf"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
